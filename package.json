{
  "name": "eduai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "dev:log": "mkdir -p .logs && npm run dev 2>&1 | tee .logs/dev.log",
    "dev:local": "npm run prisma:migrate && npm run dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:generate": "npx prisma generate",
    "postinstall": "npm run prisma:generate",
    "backtest:self-check": "bash scripts/prediction-backtest-self-check.sh",
    "calibration:self-check": "bash scripts/prediction-calibration-self-check.sh",
    "dataset-export:self-check": "bash scripts/dataset-export-self-check.sh",
    "rate-limit:self-check": "bash scripts/rate-limit-self-check.sh"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "framer-motion": "^12.34.0",
    "jsonwebtoken": "^9.0.2",
    "next": "16.1.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.3",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
