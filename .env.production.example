# Production environment example

# Neon PostgreSQL connection strings
# DATABASE_URL: pooled/runtime URL used by the Vercel application.
DATABASE_URL="postgresql://<user>:<password>@<pooled-host>/<database>?sslmode=require&schema=public"
# DIRECT_URL: direct/unpooled URL used by Prisma migrate deploy.
DIRECT_URL="postgresql://<user>:<password>@<direct-host>/<database>?sslmode=require&schema=public"

# JWT signing secret (long random value)
JWT_SECRET="<set-a-long-random-secret>"

# OpenAI-compatible provider credentials
OPENAI_API_KEY="<provider-api-key>"
OPENAI_BASE_URL="https://api.openai.com/v1"
# Optional semantic validation for generated tests. Keep disabled until latency/cost is accepted.
EDUAI_LLM_TEST_JUDGE="0"

# Keep raw chat storage disabled unless explicitly required
CHAT_STORE_RAW_CONTENT="0"

# Secret for deterministic anonymized dataset export hashing
DATASET_EXPORT_SECRET="<set-a-separate-random-secret>"

# THU six-factor ML scorer.
# ML/apply is explicit-on after the runtime artifact is deployed.
# Set EDUAI_SIX_FACTOR_ML_POLICY="0" for legacy fallback.
# Set EDUAI_SIX_FACTOR_APPLY="0" or EDUAI_SIX_FACTOR_SHADOW_ONLY="1" for diagnostic rollback.
EDUAI_SIX_FACTOR_SHADOW="1"
EDUAI_SIX_FACTOR_ML_POLICY="1"
EDUAI_SIX_FACTOR_APPLY="1"
EDUAI_SIX_FACTOR_ARTIFACT_PATH="artifacts/runtime/eduai_native_pedagogy/thu_linear_candidate_scorer_v1/artifact.json"

# Prediction accuracy ML-first requires a runtime-eligible trained artifact and active_policy artifact_ml.
# Do not set this to a missing, synthetic, unfiltered, or DEV artifact in production.
# A Vercel demo may exercise the tracked DEV artifact only with non-production labeling.
# EDUAI_ML_ARTIFACT_PATH="configs/ml_accuracy_logreg_artifact.local.json"
# Set to 1 only for an intentional demo/operator view of the six-factor card.
# Keeping this 0 does not disable the runtime six-factor decision itself.
NEXT_PUBLIC_SHOW_ML_PERSONALIZATION="0"
