# Local development environment template.
# Do not put real credentials in this file.

# PostgreSQL.
# Use the pooled/runtime connection for DATABASE_URL and the direct/unpooled
# connection for DIRECT_URL when using Neon.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DB?sslmode=require&channel_binding=require"

# JWT signing secret for local auth
JWT_SECRET="replace-with-a-long-random-local-secret"

# OpenAI-compatible provider
OPENAI_API_KEY="replace-with-local-provider-key"
OPENAI_BASE_URL="https://api.openai.com/v1"
# Optional semantic validation for generated tests. Disabled by default.
EDUAI_LLM_TEST_JUDGE="0"

# Privacy default: keep raw chat storage disabled
CHAT_STORE_RAW_CONTENT="0"

# Optional: dataset export pseudonym secret
DATASET_EXPORT_SECRET="replace-with-local-export-secret"

# Local/demo six-factor ML scorer mode is explicit-on.
# Set EDUAI_SIX_FACTOR_ML_POLICY="0" for legacy fallback.
# Set EDUAI_SIX_FACTOR_APPLY="0" or EDUAI_SIX_FACTOR_SHADOW_ONLY="1" for diagnostic rollback.
EDUAI_SIX_FACTOR_SHADOW="1"
EDUAI_SIX_FACTOR_ML_POLICY="1"
EDUAI_SIX_FACTOR_APPLY="1"
EDUAI_SIX_FACTOR_ARTIFACT_PATH="artifacts/runtime/eduai_native_pedagogy/thu_linear_candidate_scorer_v1/artifact.json"

# Prediction accuracy ML-first requires a runtime-eligible trained artifact and active_policy artifact_ml.
# The default local path is intentionally ignored unless created by training/export.
# Do not use synthetic or unfiltered local artifacts as ML-first readiness evidence.
# Forced DEV pipeline checks may use configs/ml_accuracy_logreg_artifact.dev.json, but productionEligible=false.
# EDUAI_ML_ARTIFACT_PATH="configs/ml_accuracy_logreg_artifact.local.json"
NEXT_PUBLIC_SHOW_ML_PERSONALIZATION="1"
