# Local development environment (dev-only values)

# PostgreSQL (docker-compose defaults)
DATABASE_URL="postgresql://eduai:eduai_dev_password@localhost:5432/eduai?schema=public"

# JWT signing secret for local auth
JWT_SECRET="replace-with-a-long-random-local-secret"

# OpenAI-compatible provider
OPENAI_API_KEY="replace-with-local-provider-key"
OPENAI_BASE_URL="https://api.openai.com/v1"

# Privacy default: keep raw chat storage disabled
CHAT_STORE_RAW_CONTENT="0"

# Optional: dataset export pseudonym secret
DATASET_EXPORT_SECRET="replace-with-local-export-secret"
