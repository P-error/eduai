generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                       String        @id @default(cuid())
  externalId               String?       @unique
  email                    String?       @unique
  passwordHash             String?
  researchConsentAt        DateTime?
  researchConsentVersion   String?
  researchConsentWithdrawnAt DateTime?
  trainingDataExclusionAt  DateTime?
  trainingDataExclusionReason String?
  name                     String?
  isAdmin                  Boolean       @default(false)
  declaredPreferencesJson  Json?
  effectivePreferencesJson Json?
  personalizationReady     Boolean       @default(false)
  testsTaken               Int           @default(0)
  createdAt                DateTime      @default(now())

  tests        GeneratedTest[]
  attempts     TestAttempt[]
  tagStats     UserTagStat[]
  chatSessions ChatSession[]
  evaluationEpisodes EvaluationEpisode[]
  collections  Collection[]
  subjects     Subject[]
  operatorAuditEvents OperatorAuditEvent[]
}

model Collection {
  id        String      @id @default(cuid())
  userId    String?
  name      String
  parentId  String?
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user     User?        @relation(fields: [userId], references: [id])
  parent   Collection?  @relation("CollectionHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Collection[] @relation("CollectionHierarchy")
  subjects Subject[]

  @@index([userId])
  @@unique([userId, parentId, name])
}

model Subject {
  id        String          @id @default(cuid())
  userId    String?
  title     String          @map("name")
  description String?
  collectionId String?
  archivedAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt

  user         User?           @relation(fields: [userId], references: [id])
  collection   Collection?     @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  sections     SubjectSection[]
  tests        GeneratedTest[]
  chatSessions ChatSession[]
  evaluationEpisodes EvaluationEpisode[]

  @@index([userId])
  @@unique([userId, collectionId, title])
}

model SubjectSection {
  id          String          @id @default(cuid())
  subjectId   String
  title       String
  description String?
  parentId    String?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  subject Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  parent  SubjectSection? @relation("SubjectSectionHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children SubjectSection[] @relation("SubjectSectionHierarchy")
  tests   GeneratedTest[]
  evaluationEpisodes EvaluationEpisode[]

  @@index([subjectId])
  @@index([parentId])
  @@index([subjectId, sortOrder])
}

model GeneratedTest {
  id                  String          @id @default(cuid())
  userId              String?
  subjectId           String
  sectionId           String?
  evaluationEpisodeId String?
  promptTemplateId    String?
  llmModel            String?
  promptTemplateKey   String?
  promptTemplateVersion Int?
  promptTemplateSnapshot String?
  rawLlmOutput        String?
  normalizedJson      Json?
  validationMetaJson  Json?
  sectionSnapshot     String?
  recommended         Boolean         @default(false)
  recommendationSnapshot Json?
  topic               String
  questionCount       Int
  mode                String
  questionsJson       Json
  profileSnapshotJson Json?
  createdAt           DateTime        @default(now())

  user           User?           @relation(fields: [userId], references: [id])
  subject        Subject         @relation(fields: [subjectId], references: [id])
  section        SubjectSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  evaluationEpisode EvaluationEpisode? @relation(fields: [evaluationEpisodeId], references: [id], onDelete: SetNull)
  promptTemplate PromptTemplate? @relation(fields: [promptTemplateId], references: [id])
  tagAssignments TagAssignment[]
  attempts       TestAttempt[]

  @@index([evaluationEpisodeId])
}

model TagLegendVersion {
  id        String   @id @default(cuid())
  version   String   @unique
  createdAt DateTime @default(now())
}

model TagAxis {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  createdAt DateTime @default(now())

  tags          Tag[]
  assignments   TagAssignment[]
  userTagStats  UserTagStat[]
}

model Tag {
  id        String   @id @default(cuid())
  axisId    String
  key       String
  label     String
  createdAt DateTime @default(now())

  axis TagAxis @relation(fields: [axisId], references: [id])

  assignments  TagAssignment[]
  userTagStats UserTagStat[]

  @@unique([axisId, key])
}

model TagAssignment {
  id            String   @id @default(cuid())
  testId        String
  questionIndex Int
  axisId        String
  tagId         String
  createdAt     DateTime @default(now())

  test GeneratedTest @relation(fields: [testId], references: [id])
  axis TagAxis       @relation(fields: [axisId], references: [id])
  tag  Tag           @relation(fields: [tagId], references: [id])

  @@unique([testId, questionIndex, axisId])
}

model TestAttempt {
  id          String   @id @default(cuid())
  testId      String
  userId      String
  answersJson Json
  score       Float
  byTagJson   Json
  totalDurationMs           Int?
  perQuestionFirstAnswerMsJson Json?
  answerChangeCount         Int?     @default(0)
  createdAt   DateTime @default(now())

  test GeneratedTest @relation(fields: [testId], references: [id])
  user User          @relation(fields: [userId], references: [id])

  @@unique([userId, testId])
}

model UserTagStat {
  id           String   @id @default(cuid())
  userId       String
  axisId       String
  tagId        String
  correctCount Float    @default(0)
  totalCount   Int      @default(0)
  updatedAt    DateTime @updatedAt

  user User    @relation(fields: [userId], references: [id])
  axis TagAxis @relation(fields: [axisId], references: [id])
  tag  Tag     @relation(fields: [tagId], references: [id])

  @@unique([userId, axisId, tagId])
}

model ChatSession {
  id                       String     @id @default(cuid())
  userId                   String
  subjectId                String?
  evaluationEpisodeId      String?
  promptTemplateId         String?
  llmModel                 String?
  promptTemplateKey        String?
  promptTemplateVersion    Int?
  promptTemplateSnapshot   String?
  declaredPreferencesJson  Json?
  effectivePreferencesJson Json?
  personalizationReady     Boolean    @default(false)
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  user           User           @relation(fields: [userId], references: [id])
  subject        Subject?       @relation(fields: [subjectId], references: [id])
  evaluationEpisode EvaluationEpisode? @relation(fields: [evaluationEpisodeId], references: [id], onDelete: SetNull)
  promptTemplate PromptTemplate? @relation(fields: [promptTemplateId], references: [id])
  messages       ChatMessage[]

  @@index([evaluationEpisodeId])
}

model ChatMessage {
  id          String   @id @default(cuid())
  sessionId   String
  role        String
  content     String
  signalsJson Json?
  createdAt   DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id])
}

model PromptTemplate {
  id        String   @id @default(cuid())
  key       String
  version   Int
  template  String
  notes     String?
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tests        GeneratedTest[]
  chatSessions ChatSession[]

  @@unique([key, version])
}

model EvaluationEpisode {
  id                String   @id @default(cuid())
  userId            String
  clientKey         String?  @unique
  subjectId         String?
  sectionId         String?
  datasetPhase      String   @default("real")
  datasetOrigin     String   @default("runtime_user")
  objectiveKey      String
  protocolKey       String
  status            String   @default("active")
  policyArm         String
  primarySignalKind String
  topic             String?
  conceptKey        String?
  skillKey          String?
  assignmentJson    Json
  designJson        Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user        User            @relation(fields: [userId], references: [id])
  subject     Subject?        @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  section     SubjectSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  tests       GeneratedTest[]
  chatSessions ChatSession[]
  items       EvaluationEpisodeItem[]

  @@index([userId, createdAt])
  @@index([subjectId, createdAt])
  @@index([userId, policyArm, createdAt])
  @@index([datasetPhase, createdAt])
}

model EvaluationEpisodeItem {
  id                     String   @id @default(cuid())
  episodeId              String
  contentKind            String
  contentId              String
  sequenceIndex          Int
  sequenceRole           String
  touchpointType         String
  signalQuality          String
  itemRole               String
  itemVariant            String
  linkageKind            String
  linkedContentId        String?
  familyKey              String?
  conceptKey             String?
  skillKey               String?
  holdoutStrategy        String
  delayedMinutes         Int?
  policyArm              String
  subjectId              String?
  sectionId              String?
  topic                  String?
  pedagogicalDecisionJson Json?
  decisionRuntimeJson    Json?
  outcomeJson            Json?
  deliveredAt            DateTime @default(now())
  outcomeRecordedAt      DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  episode EvaluationEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([contentKind, contentId])
  @@unique([episodeId, sequenceRole])
  @@unique([episodeId, sequenceIndex])
  @@index([episodeId, sequenceRole])
  @@index([episodeId, familyKey])
  @@index([episodeId, linkedContentId])
}

model RateLimitBucket {
  key        String   @id
  routeClass String
  bucketKind String
  limit      Int
  windowMs   Int
  count      Int
  resetAt    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([routeClass, resetAt])
  @@index([resetAt])
}

model OperatorAuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  targetType  String
  targetId    String?
  result      String
  ipAddress   String?
  summaryJson Json?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}
